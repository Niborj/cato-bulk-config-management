# One-shot migration: adopt the 3 live Private Access rules into state. The
# Private Access terraform surface has no section resources yet, and no
# account-level policy toggle resource is wired into this module — the only
# importable resource is cato_private_access_rule. Safe to delete this file
# after a successful `terraform apply` adopts the rules.
#
# BLOCKED (see README.md): this plan cannot currently be previewed/applied
# because `terraform validate` fails on the missing
# cato_private_access_rule_bulk resource type. Written and ready for when
# the provider blocker clears.

locals {
  migrate_json  = jsondecode(file("../../config_data/all_pa_rules_and_sections.json"))
  migrate_rules = { for rw in local.migrate_json.data.policy.privateAccess.policy.rules : rw.rule.name => rw.rule.id }
}

import {
  for_each = local.migrate_rules

  to = module.pa_rules.cato_private_access_rule.rules[each.key]
  id = each.value
}
