# One-shot adoption of the live Split Tunnel rule(s).
# Run `terraform plan` to preview, then `terraform apply`, then delete this
# file — it's a one-time migration aid, not steady-state config.

locals {
  st_migration_json     = jsondecode(file("../../config_data/all_st_rules_and_sections.json"))
  st_migration_policy   = local.st_migration_json.data.policy.splitTunnel.policy
  st_migration_sections = { for s in local.st_migration_policy.sections : s.section_name => s.section_id }
  st_migration_rules    = { for rw in local.st_migration_policy.rules : rw.rule.name => rw.rule.id }
}

import {
  for_each = local.st_migration_sections
  to       = module.st_rules.cato_split_tunnel_section.sections[each.key]
  id       = each.value
}

import {
  for_each = local.st_migration_rules
  to       = module.st_rules.cato_split_tunnel_rule.rules[each.key]
  id       = each.value
}

# cato_bulk_st_move_rule is plan-time orchestration — it republishes the
# whole policy on every apply and has no persisted object of its own, so it
# is never imported. Same for the optional cato_split_tunnel_policy
# enable/disable toggle: a tenant-wide singleton with no name/for_each to key
# an import block on (left unmanaged here; policy_enabled defaults to null).
