# One-shot adoption of the live Remote Port Forwarding rule(s).
# Run `terraform plan` to preview, then `terraform apply`, then delete this
# file — it's a one-time migration aid, not steady-state config.

locals {
  rpf_migration_json     = jsondecode(file("../../config_data/all_rpf_rules_and_sections.json"))
  rpf_migration_policy   = local.rpf_migration_json.data.policy.remotePortFwd.policy
  rpf_migration_sections = { for s in local.rpf_migration_policy.sections : s.section_name => s.section_id }
  rpf_migration_rules    = { for rw in local.rpf_migration_policy.rules : rw.rule.name => rw.rule.id }
}

import {
  for_each = local.rpf_migration_sections
  to       = module.rpf_rules.cato_remote_port_fwd_section.sections[each.key]
  id       = each.value
}

import {
  for_each = local.rpf_migration_rules
  to       = module.rpf_rules.cato_remote_port_fwd_rule.rules[each.key]
  id       = each.value
}

# cato_bulk_rpf_move_rule is plan-time orchestration — it republishes the
# whole policy on every apply and has no persisted object of its own, so it
# is never imported. Same for the optional cato_remote_port_fwd_policy
# enable/disable toggle: a tenant-wide singleton with no name/for_each to key
# an import block on (left unmanaged here; policy_enabled defaults to null).
