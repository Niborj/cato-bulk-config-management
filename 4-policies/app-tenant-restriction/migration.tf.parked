# One-shot migration: adopt the 3 live App Tenant Restriction rules into
# state. No sections exist live (0), so no section import blocks are
# needed. Safe to delete this file after a successful `terraform apply`
# adopts them.
#
# BLOCKED (see README.md): this plan cannot currently be previewed/applied
# because `terraform validate` fails on the missing cato_bulk_atr_move_rule
# resource type. Written and ready for when the provider blocker clears.

locals {
  migrate_json   = jsondecode(file("../../config_data/all_atr_rules_and_sections.json"))
  migrate_policy = local.migrate_json.data.policy.appTenantRestriction.policy
  migrate_rules  = { for rw in local.migrate_policy.rules : rw.rule.name => rw.rule.id }
}

import {
  for_each = local.migrate_rules

  to = module.atr_rules.cato_app_tenant_restriction_rule.rules[each.key]
  id = each.value
}
