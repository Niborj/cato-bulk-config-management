# One-shot brownfield RE-adoption of the live Internet Firewall policy,
# including sub-policies and their rules.
#
# PRECONDITION (manual, the operator): this folder's old state references the
# pre-rebuild tenant and is hollow (every remote object deleted). Retire it
# first or these import blocks error with "resource already managed":
#
#   mv terraform.tfstate         terraform.tfstate.pre-readoption-$(date +%Y%m%d).bak
#   mv terraform.tfstate.backup  terraform.tfstate.backup.pre-readoption-$(date +%Y%m%d).bak
#
# Clean plan: "N to import, 1 to add (the cato_bulk_if_move_rule ordering
# resource — no live object, created on first apply), 0 to change, 0 to
# destroy." Apply, then delete this file.

locals {
  ifw_migration = jsondecode(file("../../config_data/all_ifw_rules_and_sections.json")).data.policy.internetFirewall.policy

  # Main-policy vs sub-policy split. A section/rule carries sub_policy_name only
  # when it lives INSIDE a sub-policy. The module manages sub-sections via an
  # output only (there is no cato_if_section resource for them), so ONLY main
  # sections are imported; sub-policy rules import as cato_if_rule.sub_rules.
  ifw_main_sections = { for s in local.ifw_migration.sections : s.section_name => s if try(s.sub_policy_name, null) == null }
  ifw_main_rules    = { for r in local.ifw_migration.rules : r.rule.name => r.rule if try(r.sub_policy_name, null) == null }
  ifw_sub_policies  = { for sp in try(local.ifw_migration.sub_policies, []) : sp.sub_policy_name => sp }
  ifw_sub_rules     = { for r in local.ifw_migration.rules : "${r.sub_policy_name}::${r.rule.name}" => r.rule if try(r.sub_policy_name, null) != null }
}

import {
  for_each = local.ifw_main_sections
  to       = module.if_rules.cato_if_section.sections[each.key]
  id       = each.value.section_id
}

import {
  for_each = local.ifw_main_rules
  to       = module.if_rules.cato_if_rule.rules[each.key]
  id       = each.value.id
}

import {
  for_each = local.ifw_sub_policies
  to       = module.if_rules.cato_if_sub_policy.sub_policies[each.key]
  id       = each.value.sub_policy_id
}

import {
  for_each = local.ifw_sub_rules
  to       = module.if_rules.cato_if_rule.sub_rules[each.key]
  id       = each.value.id
}
