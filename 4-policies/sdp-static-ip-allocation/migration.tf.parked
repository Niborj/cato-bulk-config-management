# One-shot adoption of the live SDP Static IP Allocation rule(s).
# Run `terraform plan` to preview, then `terraform apply`, then delete this
# file — it's a one-time migration aid, not steady-state config.

locals {
  ssia_migration_json     = jsondecode(file("../../config_data/all_ssia_rules_and_sections.json"))
  ssia_migration_policy   = local.ssia_migration_json.data.policy.sdpStaticIpAllocation.policy
  ssia_migration_sections = { for s in local.ssia_migration_policy.sections : s.section_name => s.section_id }
  ssia_migration_rules    = { for rw in local.ssia_migration_policy.rules : rw.rule.name => rw.rule.id }
}

import {
  for_each = local.ssia_migration_sections
  to       = module.ssia_rules.cato_sdp_static_ip_allocation_section.sections[each.key]
  id       = each.value
}

import {
  for_each = local.ssia_migration_rules
  to       = module.ssia_rules.cato_sdp_static_ip_allocation_rule.rules[each.key]
  id       = each.value
}

# cato_bulk_ssia_move_rule is plan-time orchestration — it republishes the
# whole policy on every apply and has no persisted object of its own, so it
# is never imported. Same for the optional
# cato_sdp_static_ip_allocation_policy enable/disable toggle: a tenant-wide
# singleton with no name/for_each to key an import block on (left unmanaged
# here; policy_enabled defaults to null).
