# Option A — explicit credentials (previous behavior):
cato_token = "REPLACE_WITH_CATO_API_TOKEN"
account_id = "REPLACE_WITH_CATO_ACCOUNT_ID"

# Option B — catocli profile authentication (requires provider >= 1.5.0-prerelease.3).
# Leave the token/account lines above unset/commented and let the provider read
# ~/.cato/credentials. Alternatively skip tfvars entirely:  CATO_PROFILE=<profile> terraform plan
# cato_profile = "<target-profile>"
